DATABASE_URL=postgresql://siteguard:siteguard@localhost:5434/siteguard
REDIS_URL=redis://localhost:6380
API_PORT=3000
DASHBOARD_ORIGIN=http://localhost:5173
# Where reports/exports and k6 working files are written
REPORTS_DIR=./reports
# k6: "auto" uses a local k6 binary if found, otherwise Docker (grafana/k6)
K6_MODE=auto
K6_DOCKER_IMAGE=grafana/k6:latest

# Secrets for journeys: reference them as {{env.SG_SHOP_PASSWORD}}. Only SG_* names can be read; values never enter the database.
# SG_SHOP_PASSWORD=
