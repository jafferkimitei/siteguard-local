{
  "name": "@siteguard/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "db:push": "dotenv -e ../../.env -- prisma db push --skip-generate && dotenv -e ../../.env -- prisma generate",
    "db:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "@types/node": "^22.0.0",
    "dotenv-cli": "^8.0.0"
  }
}